# ============================================================
# SafeSite AI — .gitignore
# Prevents secrets and large files from being committed to Git
# ============================================================

# ── Python ──
__pycache__/
*.py[cod]
*.pyo
venv/
.env
*.egg-info/
dist/
build/

# ── Node / React ──
node_modules/
dist/
.DS_Store

# ── Uploaded videos (can be huge!) ──
backend/uploads/

# ── AI model weights (downloaded automatically) ──
ai-service/model/*.pt
ai-service/model/*.pth

# ── IDE ──
.vscode/
.idea/
*.swp

# ── Logs ──
*.log